<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(AvsCurrentTargetFramework);$(AvsCurrentBrowserTargetFramework);$(AvsNextBrowserTargetFramework)</TargetFrameworks>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WebAppDir>$(MSBuildThisFileDirectory)webapp</WebAppDir>
    <WebAppOutputDir>$(MSBuildThisFileDirectory)wwwroot</WebAppOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Remove="@(SupportedPlatform)" />
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <Import Project="../../../build/BuildTargets.targets" />
  <Import Project="../../../build/NullableEnable.props" />
  <Import Project="../../../build/TrimmingEnable.props" />

  <ItemGroup>
    <ProjectReference Include="../../../packages/Avalonia/Avalonia.csproj" />
    <ProjectReference Include="../../Skia/Avalonia.Skia/Avalonia.Skia.csproj" />
    <ProjectReference Include="../../HarfBuzz/Avalonia.HarfBuzz/Avalonia.HarfBuzz.csproj" />
  </ItemGroup>

  <!-- .NET 11 requires Skia/HarfBuzz compiled with EMSDK 5.0.6 -->
  <!-- These Skia/HarfBuzz versions are newer than what we ship with Avalonia.Skia and Avalonia.HarfBuzz -->
  <ItemGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))">
    <PackageReference Include="SkiaSharp" VersionOverride="4.151.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" VersionOverride="4.151.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" VersionOverride="4.151.2" />
    <PackageReference Include="HarfBuzzSharp" VersionOverride="14.2.1.200" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" VersionOverride="14.2.1.200" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" VersionOverride="14.2.1.200" />
  </ItemGroup>

  <!--
    inputLayout.g.ts is generated from BrowserInputLayout.cs before the web app build. The task assembly links the
    layout types and runs in its own process (TaskHostFactory), so a rebuilt task is picked up without locking.
  -->
  <PropertyGroup>
    <BrowserBuildTasksProject>$(MSBuildThisFileDirectory)../../tools/Avalonia.Browser.BuildTasks/Avalonia.Browser.BuildTasks.csproj</BrowserBuildTasksProject>
    <BrowserBuildTasksAssembly>$(MSBuildThisFileDirectory)../../tools/Avalonia.Browser.BuildTasks/bin/$(Configuration)/netstandard2.0/Avalonia.Browser.BuildTasks.dll</BrowserBuildTasksAssembly>
    <InputLayoutTypeScript>$(WebAppDir)/modules/avalonia/inputLayout.g.ts</InputLayoutTypeScript>
  </PropertyGroup>

  <ItemGroup>
    <!-- Restore and build ordering only. -->
    <ProjectReference Include="$(BrowserBuildTasksProject)" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <UsingTask TaskName="Avalonia.Browser.BuildTasks.GenerateInputLayoutTask" AssemblyFile="$(BrowserBuildTasksAssembly)" TaskFactory="TaskHostFactory" />

  <Target Name="GenerateInputLayout"
          Inputs="BrowserInputLayout.cs;$(BrowserBuildTasksAssembly)"
          Outputs="$(InputLayoutTypeScript)">
    <GenerateInputLayoutTask OutputFile="$(InputLayoutTypeScript)" />
  </Target>

  <!-- Runs ahead of the project references, from the outer build: build the task assembly first. -->
  <Target Name="BuildBrowserBuildTasks">
    <MSBuild Projects="$(BrowserBuildTasksProject)" Targets="Build"
             Properties="Configuration=$(Configuration)" RemoveProperties="TargetFramework;RuntimeIdentifier" />
  </Target>

  <ItemGroup>
    <Content Include="build\Avalonia.Browser.props">
      <Pack>true</Pack>
      <PackagePath>build/;buildTransitive/;buildMultiTargeting/</PackagePath>
    </Content>
    <Content Include="build\Avalonia.Browser.targets">
      <Pack>true</Pack>
      <PackagePath>build/;buildTransitive/</PackagePath>
    </Content>
    <Content Include="native\**\*.*">
      <Pack>true</Pack>
      <PackagePath>native/</PackagePath>
    </Content>
  </ItemGroup>

  <Target Name="BunInstall" Inputs="$(WebAppDir)/package.json" Outputs="$(WebAppDir)/node_modules/.install-stamp">
    <!-- We use bun packages as .NET tool, to avoid preinstalled node.js dependency -->
    <Exec Command="dnx Bun.Unofficial.Tool --yes -- install" WorkingDirectory="$(WebAppDir)" />
    <!-- Write the stamp file, so incremental builds work -->
    <Touch Files="$(WebAppDir)/node_modules/.install-stamp" AlwaysCreate="true" />
  </Target>

  <ItemGroup>
    <!-- ItemGroup defined to track BunRunBuild inputs with msbuild -->
    <AvaloniaWebAppSource Include="$(WebAppDir)/build.js;$(WebAppDir)/package.json;$(WebAppDir)/tsconfig.json" />
    <AvaloniaWebAppSource Include="$(WebAppDir)/modules/**/*.ts;$(WebAppDir)/types/**/*.ts" />
    <AvaloniaWebAppSource Include="BrowserInputLayout.cs" />
  </ItemGroup>

  <Target Name="BunRunBuild" DependsOnTargets="BunInstall;BuildBrowserBuildTasks;GenerateInputLayout"
          BeforeTargets="DispatchToInnerBuilds;BeforeBuild"
          Inputs="@(AvaloniaWebAppSource)"
          Outputs="$(WebAppOutputDir)/avalonia.js;$(WebAppOutputDir)/storage.js;$(WebAppOutputDir)/avalonia-sw.js">
    <Exec Command="dnx Bun.Unofficial.Tool build.js" WorkingDirectory="$(WebAppDir)" />
  </Target>

  <!--
    Packed as plain files; build/Avalonia.Browser.targets defines the static web assets in the app.
    Added from a target because wwwroot only exists after esbuild runs.
  -->
  <Target Name="IncludeAvaloniaWebAppPackageFiles"
          DependsOnTargets="BunRunBuild"
          BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <Content Include="wwwroot\**" Pack="true" PackagePath="staticwebassets/" CopyToOutputDirectory="Never" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Compile Include="..\..\Shared\RawEventGrouping.cs">
      <Link>RawEventGrouping.cs</Link>
    </Compile>
  </ItemGroup>

</Project>
