<Project>
  <PropertyGroup>
    <EmccFlags Condition="'$(AvaloniaAllowWebGl2)' == 'true'">$(EmccFlags) -sUSE_WEBGL2=1 -sMAX_WEBGL_VERSION=2 -lGL </EmccFlags>
    <WasmBuildNative Condition="'$(WasmBuildNative)' == ''">true</WasmBuildNative>
  </PropertyGroup>

  <ItemGroup>
    <!-- So we can access Emscripten APIs -->
    <EmccExportedRuntimeMethod Include="GL" />
    <EmccExportedRuntimeMethod Include="PThread" Condition="'$(WasmEnableThreads)' == 'true'" />
  </ItemGroup>

  <!-- wwwroot/ in the repo, staticwebassets/ in the package. -->
  <PropertyGroup>
    <_AvaloniaBrowserJsDir Condition="Exists('$(MSBuildThisFileDirectory)../wwwroot/avalonia.js')">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)../wwwroot'))</_AvaloniaBrowserJsDir>
    <_AvaloniaBrowserJsDir Condition="'$(_AvaloniaBrowserJsDir)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)../staticwebassets'))</_AvaloniaBrowserJsDir>
  </PropertyGroup>

  <!-- Legacy WASM projects have no static web assets pipeline. -->
  <ItemGroup Condition="'$(UsingMicrosoftNETSdkStaticWebAssets)' != 'true'">
    <WasmExtraFilesToDeploy Include="$(_AvaloniaBrowserJsDir)**/*.*"
                            TargetPath="_content/Avalonia.Browser/%(FileName)%(Extension)" />
  </ItemGroup>

  <!--
    Assets are defined in the app's build, not packed from this project.
    A hard fingerprint renames the file, which static hosting needs,
    but it does not survive `dotnet pack` on the .NET 10 SDK:
    the packed props record the resolved name and drop the marker.
    Evaluating the expression in the app keeps it intact.
    Mirrors _ResolveBlazorWasmOutputs in Microsoft.NET.Sdk.BlazorWebAssembly.
    .NET 11 fixes pack, but only for consumers on the .NET 11 SDK.
  -->
  <Target Name="_AvaloniaBrowserDefineStaticWebAssets"
          Condition="'$(UsingMicrosoftNETSdkStaticWebAssets)' == 'true'"
          AfterTargets="ResolveProjectStaticWebAssets"
          DependsOnTargets="ResolveStaticWebAssetsConfiguration;ResolveReferences">

    <!-- Design time builds do not build the project reference, so wwwroot may legitimately be absent. -->
    <Error Condition="!Exists('$(_AvaloniaBrowserJsDir)avalonia.js') and '$(DesignTimeBuild)' != 'true'"
           Code="AVA3002"
           Text="Avalonia.Browser JavaScript assets were not found in '$(_AvaloniaBrowserJsDir)'. This usually indicates a packaging error." />

    <PropertyGroup>
      <!--
        A renamed file only resolves through the import map,
        which the SDK emits only when OverrideHtmlAssetPlaceholders is on.
        Without it, keep the plain names so existing apps keep working.
      -->
      <_AvaloniaBrowserFingerprintJs Condition="'$(OverrideHtmlAssetPlaceholders)' == 'true' and '$(StaticWebAssetsFingerprintContent)' != 'false'">true</_AvaloniaBrowserFingerprintJs>
      <_AvaloniaBrowserFingerprintJs Condition="'$(_AvaloniaBrowserFingerprintJs)' == ''">false</_AvaloniaBrowserFingerprintJs>
    </PropertyGroup>

    <ItemGroup Condition="Exists('$(_AvaloniaBrowserJsDir)avalonia.js')">
      <!-- Imported by specifier, so the import map rewrites them. -->
      <_AvaloniaBrowserFingerprintedJs Include="$(_AvaloniaBrowserJsDir)avalonia.js;$(_AvaloniaBrowserJsDir)storage.js" />
      <!-- Loaded by URL (serviceWorker.register, sourceMappingURL), which the import map does not rewrite. -->
      <_AvaloniaBrowserPlainJs Include="$(_AvaloniaBrowserJsDir)sw.js;$(_AvaloniaBrowserJsDir)*.map" />

      <!-- Separate update: %(Filename) would be a self-reference (MSB4120). -->
      <_AvaloniaBrowserFingerprintedJs>
        <RelativePath>_content/Avalonia.Browser/%(Filename)%(Extension)</RelativePath>
      </_AvaloniaBrowserFingerprintedJs>
      <_AvaloniaBrowserPlainJs>
        <RelativePath>_content/Avalonia.Browser/%(Filename)%(Extension)</RelativePath>
      </_AvaloniaBrowserPlainJs>

      <_AvaloniaBrowserJsFingerprintPattern Include="Js" Pattern="*.js" Expression="#[.{fingerprint}]!" />
    </ItemGroup>

    <DefineStaticWebAssets
      Condition="'@(_AvaloniaBrowserFingerprintedJs)' != ''"
      CandidateAssets="@(_AvaloniaBrowserFingerprintedJs)"
      FingerprintCandidates="$(_AvaloniaBrowserFingerprintJs)"
      FingerprintPatterns="@(_AvaloniaBrowserJsFingerprintPattern)"
      SourceId="$(PackageId)"
      SourceType="Computed"
      AssetKind="All"
      AssetRole="Primary"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
      ContentRoot="$(_AvaloniaBrowserJsDir)"
      BasePath="$(StaticWebAssetBasePath)">
      <Output TaskParameter="Assets" ItemName="_AvaloniaBrowserStaticWebAsset" />
    </DefineStaticWebAssets>

    <DefineStaticWebAssets
      Condition="'@(_AvaloniaBrowserPlainJs)' != ''"
      CandidateAssets="@(_AvaloniaBrowserPlainJs)"
      FingerprintCandidates="false"
      SourceId="$(PackageId)"
      SourceType="Computed"
      AssetKind="All"
      AssetRole="Primary"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
      ContentRoot="$(_AvaloniaBrowserJsDir)"
      BasePath="$(StaticWebAssetBasePath)">
      <Output TaskParameter="Assets" ItemName="_AvaloniaBrowserStaticWebAsset" />
    </DefineStaticWebAssets>

    <DefineStaticWebAssetEndpoints
      Condition="'@(_AvaloniaBrowserStaticWebAsset)' != ''"
      CandidateAssets="@(_AvaloniaBrowserStaticWebAsset)"
      ExistingEndpoints="@(StaticWebAssetEndpoint)"
      ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="_AvaloniaBrowserStaticWebAssetEndpoint" />
    </DefineStaticWebAssetEndpoints>

    <ItemGroup>
      <StaticWebAsset Include="@(_AvaloniaBrowserStaticWebAsset)" />
      <StaticWebAssetEndpoint Include="@(_AvaloniaBrowserStaticWebAssetEndpoint)" />
    </ItemGroup>
  </Target>

</Project>
