// MicroCom limitation (worked around here, generator fix deferred): generated proxies
// throw on EVERY non-zero HRESULT, success codes included. TSF calls that legitimately
// return S_FALSE - ActivateEx on an already-active thread (the norm, CUAS activates
// first) and IEnumTfRanges.Next at the end of every enumeration - are therefore invoked
// through raw vtable slots so the result stays data; see
// TsfThreadManager.ActivateThreadManager and TsfTextStore.TryGetNextRange. The upstream
// fix is a preservesig-style per-method marker in the generator; a blanket throw-only-
// on-negative change would break S_FALSE paths that leave interface out-params null
// (GetTop/GetBase on an empty context stack).

// Consumed as proxies over TSF-implemented ranges. Only the members the store calls
// carry exact managed signatures; the rest keep the vtable slot with opaque LPVOID
// parameters (the MicroCom dialect cannot express their mid-list [out] params, and the
// store never invokes them).
[
    object,
    uuid(aa80e7ff-2021-11d2-93e0-0060b067b86e),
    pointer_default(unique)
]
interface ITfRange : IUnknown
{
    HRESULT GetText([in] TfEditCookie ec, [in] DWORD dwFlags, [in] LPVOID pchText, [in] ULONG cchMax, [in] LPVOID pcch);
    HRESULT SetText([in] TfEditCookie ec, [in] DWORD dwFlags, [in] LPVOID pchText, [in] LONG cch);
    HRESULT GetFormattedText([in] TfEditCookie ec, [in] LPVOID ppDataObject);
    HRESULT GetEmbedded([in] TfEditCookie ec, [in] REFGUID rguidService, [in] REFIID riid, [in] LPVOID ppunk);
    HRESULT InsertEmbedded([in] TfEditCookie ec, [in] DWORD dwFlags, [in] LPVOID pDataObject);
    HRESULT ShiftStart([in] TfEditCookie ec, [in] LONG cchReq, [in] LPVOID pcch, [in] LPVOID pHalt);
    HRESULT ShiftEnd([in] TfEditCookie ec, [in] LONG cchReq, [in] LPVOID pcch, [in] LPVOID pHalt);
    HRESULT ShiftStartToRange([in] TfEditCookie ec, [in] ITfRange* pRange, [in] DWORD aPos);
    HRESULT ShiftEndToRange([in] TfEditCookie ec, [in] ITfRange* pRange, [in] DWORD aPos);
    HRESULT ShiftStartRegion([in] TfEditCookie ec, [in] DWORD dir, [in] LPVOID pfNoRegion);
    HRESULT ShiftEndRegion([in] TfEditCookie ec, [in] DWORD dir, [in] LPVOID pfNoRegion);
    HRESULT IsEmpty([in] TfEditCookie ec, [in] LPVOID pfEmpty);
    HRESULT Collapse([in] TfEditCookie ec, [in] DWORD aPos);
    HRESULT IsEqualStart([in] TfEditCookie ec, [in] ITfRange* pWith, [in] DWORD aPos, [in] LPVOID pfEqual);
    HRESULT IsEqualEnd([in] TfEditCookie ec, [in] ITfRange* pWith, [in] DWORD aPos, [in] LPVOID pfEqual);
    HRESULT CompareStart([in] TfEditCookie ec, [in] ITfRange* pWith, [in] DWORD aPos, [in] LPVOID plResult);
    HRESULT CompareEnd([in] TfEditCookie ec, [in] ITfRange* pWith, [in] DWORD aPos, [in] LPVOID plResult);
    HRESULT AdjustForInsert([in] TfEditCookie ec, [in] ULONG cchInsert, [in] LPVOID pfInsertOk);
    HRESULT GetGravity([in] LPVOID pgStart, [in] LPVOID pgEnd);
    HRESULT SetGravity([in] TfEditCookie ec, [in] DWORD gStart, [in] DWORD gEnd);
    HRESULT Clone([out] ITfRange** ppClone);
    HRESULT GetContext([in] LPVOID ppContext);
}

