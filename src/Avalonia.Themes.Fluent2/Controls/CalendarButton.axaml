<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Padding="20">
      <StackPanel Spacing="20">
        <CalendarButton Content="Jan" />
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <CornerRadius x:Key="CalendarMonthYearItemCornerRadius">28</CornerRadius>
  <x:Double x:Key="CalendarMonthYearItemFontSize">14</x:Double>

  <ControlTheme x:Key="{x:Type CalendarButton}" TargetType="CalendarButton" BasedOn="{StaticResource DefaultCalendarButton}"/>

  <ControlTheme x:Key="DefaultCalendarButton" TargetType="CalendarButton">
    <Setter Property="ClickMode" Value="Release" />
    <Setter Property="Width" Value="56" />
    <Setter Property="Height" Value="56" />
    <Setter Property="Margin" Value="1,9" />
    <Setter Property="Padding" Value="0,0,0,0" />
    <Setter Property="Foreground" Value="{DynamicResource CalendarCalendarItemForeground}" />
    <Setter Property="Background" Value="{DynamicResource CalendarCalendarItemRevealBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CalendarCalendarItemRevealBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CalendarMonthYearItemCornerRadius}" />
    <Setter Property="FontSize" Value="{DynamicResource CalendarMonthYearItemFontSize}" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <!-- Fill backplate: carries the subtle-fill hover/press states and the accent fill of
               the highlighted (selected) item. -->
          <Border Name="Root"
                  Background="{TemplateBinding Background}"
                  BackgroundSizing="OuterBorderEdge"
                  BorderThickness="0"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  ClipToBounds="True">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="{DynamicResource ControlFasterAnimationDuration}" />
              </Transitions>
            </Border.Transitions>

            <ContentPresenter Name="PART_ContentPresenter"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Content="{TemplateBinding Content}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Margin="{TemplateBinding Padding}" />
          </Border>

          <!-- Selection ring: drawn on top of the backplate at the full item bounds. -->
          <Border Name="Border"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  CornerRadius="{TemplateBinding CornerRadius}" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- Hover/press are subtle fills in Windows 11. This theme has no hover-fill alias for
         Calendar (WinUI 2 used a reveal border instead), so Fluent 2 tokens are referenced directly. -->
    <Style Selector="^:pointerover /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondary}" />
    </Style>

    <Style Selector="^:pressed /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiary}" />
    </Style>

    <!-- WinUI calls this OutOfFocus (out of scope). Windows 11 drops the gray backplate and dims the
         text only. CalendarOutOfScopeForeground still aliases a legacy WinUI 2 brush in this theme,
         so the Fluent 2 token is referenced directly. -->
    <Style Selector="^:inactive /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiary}" />
    </Style>

    <!-- :selected marks the month/year that contains the current date; WinUI gives it the same
         filled-accent treatment as the today day item. There is no CalendarTodayBackground alias
         in this theme, so the Fluent 2 accent fill tokens are referenced directly. -->
    <Style Selector="^:selected">
      <Style Selector="^ /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
      </Style>

      <Style Selector="^ /template/ Border#Border">
        <Setter Property="BorderBrush" Value="{DynamicResource CalendarSelectedBorderBrush}" />
      </Style>

      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource CalendarTodayForeground}" />
        <Setter Property="FontWeight" Value="{DynamicResource CalendarTodayFontWeight}" />
      </Style>

      <Style Selector="^:pointerover">
        <Style Selector="^ /template/ Border#Border">
          <Setter Property="BorderBrush" Value="{DynamicResource CalendarSelectedHoverBorderBrush}" />
        </Style>
        <Style Selector="^ /template/ Border#Root">
          <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
        </Style>
      </Style>

      <Style Selector="^:pressed">
        <Style Selector="^ /template/ Border#Border">
          <Setter Property="BorderBrush" Value="{DynamicResource CalendarSelectedPressedBorderBrush}" />
        </Style>
        <Style Selector="^ /template/ Border#Root">
          <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
        </Style>
      </Style>
    </Style>

    <Style Selector="^:blackout /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource CalendarBlackoutForeground}" />
    </Style>

    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource CalendarWeekDayForegroundDisabled}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
