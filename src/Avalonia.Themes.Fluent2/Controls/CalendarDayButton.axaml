<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Padding="20">
      <StackPanel Spacing="20">
        <CalendarDayButton Content="8" />
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <!-- WinUI reference: Calendar_themeresources.xaml (Fluent v2 resources), tag winui3/release/1.5.2.
       Windows 11 day items are circular: rest is transparent with primary text, hover/press are
       subtle-fill circles, today is a filled accent circle with on-accent text, and selection is a
       1px accent ring around a transparent middle. The circular corner radius and the day item font
       size are baked into WinUI's CalendarDayItem chrome rather than exposed as theme resources,
       so they are approximated here from the WinUI visuals. -->
  <CornerRadius x:Key="CalendarDayItemCornerRadius">20</CornerRadius>
  <x:Double x:Key="CalendarDayItemFontSize">14</x:Double>

  <ControlTheme x:Key="{x:Type CalendarDayButton}" TargetType="CalendarDayButton" BasedOn="{StaticResource DefaultCalendarDayButtonTheme}"/>

  <ControlTheme x:Key="DefaultCalendarDayButtonTheme" TargetType="CalendarDayButton">
    <Setter Property="ClickMode" Value="Release" />
    <Setter Property="MinWidth" Value="40" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Margin" Value="1" />
    <Setter Property="Padding" Value="0,0,0,0" />
    <!--These are actually set on the Calendar in WinUI-->
    <Setter Property="Foreground" Value="{DynamicResource CalendarCalendarItemForeground}" />
    <Setter Property="Background" Value="{DynamicResource CalendarCalendarItemRevealBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CalendarCalendarItemRevealBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CalendarDayItemCornerRadius}" />
    <Setter Property="FontSize" Value="{DynamicResource CalendarDayItemFontSize}" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <!-- Fill circle: carries the subtle-fill hover/press states and the today accent fill.
               It is inset when today is also selected so the selection ring reads as a ring. -->
          <Border Name="Root"
                  Background="{TemplateBinding Background}"
                  BackgroundSizing="OuterBorderEdge"
                  BorderThickness="0"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  ClipToBounds="True">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="{DynamicResource ControlFasterAnimationDuration}" />
              </Transitions>
            </Border.Transitions>

            <ContentPresenter Name="PART_ContentPresenter"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Content="{TemplateBinding Content}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Margin="{TemplateBinding Padding}" />

          </Border>

          <!-- Selection ring: drawn on top of the fill circle at the full item bounds. -->
          <Border Name="Border"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  CornerRadius="{TemplateBinding CornerRadius}" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- Hover/press are subtle-fill circles in Windows 11. This theme has no hover-fill alias for
         Calendar (WinUI 2 used a reveal border instead), so Fluent 2 tokens are referenced directly. -->
    <Style Selector="^:pointerover /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondary}" />
    </Style>

    <Style Selector="^:pressed /template/ Border#Root">
      <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiary}" />
    </Style>

    <!-- WinUI calls this OutOfFocus (out of scope). Windows 11 drops the gray backplate and dims the
         text only. CalendarOutOfScopeForeground still aliases a legacy WinUI 2 brush in this theme,
         so the Fluent 2 token is referenced directly. -->
    <Style Selector="^:inactive /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiary}" />
    </Style>

    <Style Selector="^:selected">
      <Style Selector="^ /template/ Border#Border">
        <Setter Property="BorderBrush" Value="{DynamicResource CalendarSelectedBorderBrush}" />
      </Style>
      <Style Selector="^:pointerover /template/ Border#Border">
        <Setter Property="BorderBrush" Value="{DynamicResource CalendarSelectedHoverBorderBrush}" />
      </Style>
      <Style Selector="^:pressed /template/ Border#Border">
        <Setter Property="BorderBrush" Value="{DynamicResource CalendarSelectedPressedBorderBrush}" />
      </Style>
      <!-- CalendarSelectedForeground is not aliased in this theme yet, so the Fluent 2 token
           for accent text is referenced directly. -->
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
      </Style>
    </Style>

    <Style Selector="^:today">
      <!-- Today is a filled accent circle. There is no CalendarTodayBackground alias in this
           theme, so the Fluent 2 accent fill tokens are referenced directly. -->
      <Style Selector="^ /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
      </Style>
      <Style Selector="^:pointerover /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
      </Style>
      <Style Selector="^:pressed /template/ Border#Root">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource CalendarTodayForeground}" />
        <Setter Property="FontWeight" Value="{DynamicResource CalendarTodayFontWeight}" />
      </Style>
      <!-- Today + selected: inset the accent fill so a gap appears between fill and selection ring,
           mimicking the WinUI 3 ring-and-dot treatment. -->
      <Style Selector="^:selected /template/ Border#Root">
        <Setter Property="Margin" Value="3" />
      </Style>
    </Style>

    <Style Selector="^:blackout /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource CalendarBlackoutForeground}" />
    </Style>

    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource CalendarWeekDayForegroundDisabled}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
