<ResourceDictionary
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Padding="20">
      <StackPanel Spacing="20">
        <TabItem Header="Leaf" />
        <TabItem Header="Arch" IsSelected="True" />
        <TabItem Header="Background" Background="Yellow"/>
      </StackPanel>
    </Border>
  </Design.PreviewWith>
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
      <StaticResource x:Key="TabItemHeaderPillFill" ResourceKey="AccentFillColorDefaultBrush"/>
      <StaticResource x:Key="TabItemHeaderDisabledPillFill" ResourceKey="AccentFillColorDisabledBrush"/>
      <StaticResource x:Key="TabItemHeaderBorderBrush" ResourceKey="SystemControlTransparentBrush"/>
      <StaticResource x:Key="TabItemHeaderBorderBrushPointerOver" ResourceKey="SystemControlTransparentBrush"/>
      <StaticResource x:Key="TabItemHeaderBorderBrushSelected" ResourceKey="SystemControlTransparentBrush"/>
      <StaticResource x:Key="TabItemHeaderBorderBrushPressed" ResourceKey="SystemControlTransparentBrush"/>
      <StaticResource x:Key="TabItemHeaderBorderBrushDisabled" ResourceKey="SystemControlTransparentBrush"/>
      <StaticResource x:Key="TabItemHeaderForeground" ResourceKey="TextFillColorPrimaryBrush"/>
      <StaticResource x:Key="TabItemHeaderForegroundPointerOver" ResourceKey="TextFillColorSecondaryBrush"/>
      <StaticResource x:Key="TabItemHeaderForegroundSelected" ResourceKey="TextFillColorPrimaryBrush"/>
      <StaticResource x:Key="TabItemHeaderForegroundPressed" ResourceKey="TextFillColorTertiaryBrush"/>
      <StaticResource x:Key="TabItemHeaderForegroundDisabled" ResourceKey="TextFillColorDisabledBrush"/>
      <StaticResource x:Key="TabItemHeaderBackground" ResourceKey="SystemControlTransparentBrush"/>
      <StaticResource x:Key="TabItemHeaderBackgroundPointerOver" ResourceKey="SystemControlTransparentBrush"/>
      <StaticResource x:Key="TabItemHeaderBackgroundSelected" ResourceKey="SystemControlTransparentBrush"/>
      <StaticResource x:Key="TabItemHeaderBackgroundPressed" ResourceKey="SystemControlTransparentBrush"/>
      <StaticResource x:Key="TabItemHeaderBackgroundDisabled" ResourceKey="SystemControlTransparentBrush"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <StaticResource x:Key="TabItemHeaderPillFill" ResourceKey="AccentFillColorDefaultBrush"/>
      <StaticResource x:Key="TabItemHeaderDisabledPillFill" ResourceKey="AccentFillColorDisabledBrush"/>
      <StaticResource x:Key="TabItemHeaderBorderBrush" ResourceKey="SystemControlTransparentBrush"/>
      <StaticResource x:Key="TabItemHeaderBorderBrushPointerOver" ResourceKey="SystemControlTransparentBrush"/>
      <StaticResource x:Key="TabItemHeaderBorderBrushSelected" ResourceKey="SystemControlTransparentBrush"/>
      <StaticResource x:Key="TabItemHeaderBorderBrushPressed" ResourceKey="SystemControlTransparentBrush"/>
      <StaticResource x:Key="TabItemHeaderBorderBrushDisabled" ResourceKey="SystemControlTransparentBrush"/>
      <StaticResource x:Key="TabItemHeaderForeground" ResourceKey="TextFillColorPrimaryBrush"/>
      <StaticResource x:Key="TabItemHeaderForegroundPointerOver" ResourceKey="TextFillColorSecondaryBrush"/>
      <StaticResource x:Key="TabItemHeaderForegroundSelected" ResourceKey="TextFillColorPrimaryBrush"/>
      <StaticResource x:Key="TabItemHeaderForegroundPressed" ResourceKey="TextFillColorTertiaryBrush"/>
      <StaticResource x:Key="TabItemHeaderForegroundDisabled" ResourceKey="TextFillColorDisabledBrush"/>
      <StaticResource x:Key="TabItemHeaderBackground" ResourceKey="SystemControlTransparentBrush"/>
      <StaticResource x:Key="TabItemHeaderBackgroundPointerOver" ResourceKey="SystemControlTransparentBrush"/>
      <StaticResource x:Key="TabItemHeaderBackgroundSelected" ResourceKey="SystemControlTransparentBrush"/>
      <StaticResource x:Key="TabItemHeaderBackgroundPressed" ResourceKey="SystemControlTransparentBrush"/>
      <StaticResource x:Key="TabItemHeaderBackgroundDisabled" ResourceKey="SystemControlTransparentBrush"/>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <Thickness x:Key="TabItemHeaderBorderThickness">1</Thickness>
  <Thickness x:Key="TabItemHeaderIconVisualMargin">-2,0</Thickness>
  <Thickness x:Key="TabItemHeaderContentMargin">0</Thickness>
  <Thickness x:Key="TabItemHeaderPadding">12,10,12,7</Thickness>
  <Thickness x:Key="TabItemHeaderSelectionVisualMargin">0</Thickness>
  <Thickness x:Key="TabItemHeaderFocusVisualMargin">-2</Thickness>
  <x:Double x:Key="TabItemHeaderPillHeight">3</x:Double>
  <x:Double x:Key="TabItemHeaderPillWidth">4</x:Double>
  <x:Double x:Key="TabItemHeaderPillScaledWidth">16</x:Double>
  <x:Double x:Key="TabItemHeaderSpacing">8</x:Double>
  <x:TimeSpan x:Key="TabItemScaleAnimationDuration">00:00:00.167</x:TimeSpan>

  <ControlTheme x:Key="TabItemHeaderPill" TargetType="Rectangle" BasedOn="{StaticResource ComboBoxItemPill}">
    <Setter Property="Fill" Value="{DynamicResource TabItemHeaderPillFill}"/>
    <Setter Property="Height" Value="{DynamicResource TabItemHeaderPillHeight}"/>
    <Setter Property="Width" Value="{DynamicResource TabItemHeaderPillWidth}"/>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem" BasedOn="{StaticResource DefaultTabItemTheme}"/>
  <ControlTheme x:Key="DefaultTabItemTheme" TargetType="TabItem">
    <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource TabItemHeaderForeground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource TabItemHeaderBorderBrush}"/>
    <Setter Property="BorderThickness" Value="{DynamicResource TabItemHeaderBorderThickness}"/>
    <Setter Property="Padding" Value="{StaticResource TabItemHeaderPadding}"/>
    <Setter Property="Margin" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="BackgroundSizing" Value="OuterBorderEdge"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border
          Name="PART_LayoutRoot"
          Background="{TemplateBinding Background}"
          BorderBrush="{TemplateBinding BorderBrush}"
          BorderThickness="{TemplateBinding BorderThickness}"
          CornerRadius="{TemplateBinding CornerRadius}">
          <Grid RowDefinitions="Auto,Auto">
            <DockPanel
              Name="DockPanelHost"
              VerticalSpacing="{StaticResource TabItemHeaderSpacing}"
              HorizontalSpacing="{StaticResource TabItemHeaderSpacing}"
              Grid.Row="0"
              Margin="{TemplateBinding Padding}"
              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
              VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
              <ContentPresenter x:Name="PART_IconVisual"
                                Content="{TemplateBinding Icon}"
                                ContentTemplate="{TemplateBinding IconTemplate}"
                                Margin="{DynamicResource TabItemHeaderIconVisualMargin}"
                                Foreground="{TemplateBinding Foreground}"
                                RenderTransformOrigin="0.5,0.5"/>
              <ContentPresenter
                Name="PART_ContentPresenter"
                Margin="{StaticResource TabItemHeaderContentMargin}"
                Content="{TemplateBinding Header}"
                FontSize="{TemplateBinding FontSize}"
                FontFamily="{TemplateBinding FontFamily}"
                FontWeight="{TemplateBinding FontWeight}"
                ContentTemplate="{TemplateBinding HeaderTemplate}" />
            </DockPanel>
            <Rectangle
              x:Name="PART_SelectedPipe"
              Grid.Row="1"
              Theme="{StaticResource TabItemHeaderPill}"
              RadiusX="1.5"
              RadiusY="1.5"
              Margin="{DynamicResource TabItemHeaderSelectionVisualMargin}"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              IsHitTestVisible="False"
              Opacity="0">
              <Rectangle.Transitions>
                <Transitions>
                  <DoubleTransition Property="Width"
                                    Duration="{DynamicResource TabItemScaleAnimationDuration}"
                                    Easing="0,0,0,1"/>
                </Transitions>
              </Rectangle.Transitions>
            </Rectangle>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="RecognizesAccessKey" Value="True" />
    </Style>

    <Style Selector="^ /template/ ContentPresenter#PART_IconVisual:empty">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter:empty">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Pointer-over -->
    <Style Selector="^:pointerover">

      <Style Selector="^ /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource TabItemHeaderBackgroundPointerOver}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TabItemHeaderForegroundPointerOver}" />
      </Style>
    </Style>

    <!-- Pressed -->
    <Style Selector="^:pressed">

      <Style Selector="^ /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource TabItemHeaderBackgroundPressed}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TabItemHeaderForegroundPressed}" />
      </Style>
    </Style>

    <!-- Disabled -->
    <Style Selector="^:disabled">

      <Style Selector="^ /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource  TabItemHeaderBackgroundDisabled}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TabItemHeaderForegroundDisabled}" />
      </Style>

      <Style Selector="^ /template/ Rectangle#PART_SelectedPipe">
        <Setter Property="Fill" Value="{DynamicResource  TabItemHeaderDisabledPillFill}" />
      </Style>
    </Style>

    <!-- Selected state -->
    <Style Selector="^:selected">

      <Style Selector="^ /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource TabItemHeaderBackgroundSelected}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TabItemHeaderForegroundSelected}" />
      </Style>

      <Style Selector="^ /template/ Rectangle#PART_SelectedPipe">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Width" Value="{DynamicResource TabItemHeaderPillScaledWidth}" />
      </Style>

      <!-- Pointer-over -->
      <Style Selector="^:pointerover">
        <Style Selector="^ /template/ Border#PART_LayoutRoot">
          <Setter Property="Background" Value="{DynamicResource TabItemHeaderBackgroundSelected}" />
          <Setter Property="TextElement.Foreground" Value="{DynamicResource TabItemHeaderForegroundPointerOver}" />
        </Style>
      </Style>

      <!-- Pressed -->
      <Style Selector="^:pressed">

        <Style Selector="^ /template/ Border#PART_LayoutRoot">
          <Setter Property="Background" Value="{DynamicResource TabItemHeaderBackgroundSelected}" />
          <Setter Property="TextElement.Foreground" Value="{DynamicResource TabItemHeaderForegroundPointerOver}" />
        </Style>
      </Style>

      <!-- Disabled -->
      <Style Selector="^:disabled">

        <Style Selector="^ /template/ Border#PART_LayoutRoot">
          <Setter Property="Background" Value="{DynamicResource TabItemHeaderBackgroundDisabled}" />
          <Setter Property="TextElement.Foreground" Value="{DynamicResource TabItemHeaderForegroundDisabled}" />
        </Style>
      </Style>
    </Style>

    <Style Selector="^[TabStripPlacement=Left] /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>

    <Style Selector="^[TabStripPlacement=Bottom] /template/ Border#PART_SelectedPipe">
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style Selector="^[TabStripPlacement=Top] /template/ Border#PART_SelectedPipe">
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <Style Selector="^[TabStripPlacement=Right] /template/ Border#PART_SelectedPipe">
      <Setter Property="Margin" Value="0,0,2,0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style Selector="^[TabStripPlacement=Left] /template/ Border#PART_SelectedPipe">
      <Setter Property="Margin" Value="2,0,0,0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style Selector="^[TabStripPlacement=Right] /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="^[TabStripPlacement=Right]">
      <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
