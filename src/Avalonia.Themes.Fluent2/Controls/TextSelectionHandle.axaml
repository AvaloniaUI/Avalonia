<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Grid>
      <Border>
        <Image Stretch="Uniform" HorizontalAlignment="Left"
               Cursor="Arrow"
               Name="PART_HandlePathIcon"
               Height="{DynamicResource TextSelectionHandleSize}"
               Source="{DynamicResource TextSelectionHandleDrawing}">
        </Image>
      </Border>
    </Grid>
  </Design.PreviewWith>


  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="TextSelectionHandleBackground" Color="White" />
      <StaticResource x:Key="TextSelectionHandleStroke" ResourceKey="AccentFillColorSelectedTextBackgroundBrush" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="TextSelectionHandleBackground" Color="White" />
      <StaticResource x:Key="TextSelectionHandleStroke" ResourceKey="AccentFillColorSelectedTextBackgroundBrush" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <x:Double x:Key="TextSelectionHandleSize">20</x:Double>
  <x:Double x:Key="TextSelectionHandleStrokeThickness">2</x:Double>

  <DrawingImage x:Key="TextCaretHandleDrawing" Viewbox="0,0,20,20">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="{DynamicResource TextSelectionHandleBackground}"
                         >
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="10,10" RadiusX="9" RadiusY="9"/>
          </GeometryDrawing.Geometry>

        </GeometryDrawing>
        <GeometryDrawing Brush="Transparent"
                         >
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="10,10" RadiusX="6" RadiusY="6"/>
          </GeometryDrawing.Geometry>

          <GeometryDrawing.Pen>
            <Pen Thickness="{StaticResource TextSelectionHandleStrokeThickness}" Brush="{DynamicResource TextSelectionHandleStroke}"/>
          </GeometryDrawing.Pen>
        </GeometryDrawing>

        <GeometryDrawing Brush="Transparent"
                         >
          <GeometryDrawing.Geometry>
            <LineGeometry StartPoint="10,4" EndPoint="10,0"/>
          </GeometryDrawing.Geometry>

          <GeometryDrawing.Pen>
            <Pen Thickness="{StaticResource TextSelectionHandleStrokeThickness}" Brush="{DynamicResource TextSelectionHandleStroke}"/>
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <ControlTheme x:Key="{x:Type TextSelectionHandle}" TargetType="TextSelectionHandle" BasedOn="{StaticResource DefaultTextSelectionHandle}"/>
  <ControlTheme x:Key="DefaultTextSelectionHandle" TargetType="TextSelectionHandle">
    <Setter Property="Background"
            Value="{DynamicResource AccentFillColorDefaultBrush}" />
    <Setter Property="HorizontalAlignment"
            Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Grid>
            <Border Padding="0,0,0,10" IsHitTestVisible="True" Background="Transparent">
              <Image Stretch="Uniform"
                     Cursor="Arrow"
                     Name="PART_HandlePathIcon"
                     Height="{DynamicResource TextSelectionHandleSize}"
                     Source="{DynamicResource TextCaretHandleDrawing}"/>
            </Border>
            <Border Background="Transparent"
                    Name="PART_Indicator"
                    HorizontalAlignment="Center"
                    Width="1"
                    VerticalAlignment="Top"
                    Height="5"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
