<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">
  <Design.PreviewWith>
    <Border Padding="20">
      <Calendar />
    </Border>
  </Design.PreviewWith>

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
      <StaticResource x:Key="CalendarViewSelectedHoverBorderBrush" ResourceKey="AccentFillColorSecondary" />
      <StaticResource x:Key="CalendarViewSelectedPressedBorderBrush" ResourceKey="SubtleFillColorTertiary" />
      <StaticResource x:Key="CalendarViewSelectedBorderBrush" ResourceKey="AccentFillColorDefault" />
      <StaticResource x:Key="CalendarViewHoverBorderBrush" ResourceKey="ControlStrokeColorDefault" />
      <StaticResource x:Key="CalendarViewPressedBorderBrush" ResourceKey="ControlStrokeColorDefault" />
      <StaticResource x:Key="CalendarViewTodayForeground" ResourceKey="TextOnAccentFillColorPrimary" />
      <StaticResource x:Key="CalendarViewBlackoutForeground" ResourceKey="TextFillColorDisabled" />
      <StaticResource x:Key="CalendarViewOutOfScopeForeground" ResourceKey="TextFillColorTertiary" />
      <StaticResource x:Key="CalendarViewCalendarItemForeground" ResourceKey="TextFillColorPrimary" />
      <StaticResource x:Key="CalendarViewOutOfScopeBackground" ResourceKey="SubtleFillColorTransparent" />
      <StaticResource x:Key="CalendarViewForeground" ResourceKey="TextFillColorPrimary" />
      <StaticResource x:Key="CalendarViewBackground" ResourceKey="ControlFillColorInputActive" />
      <StaticResource x:Key="CalendarViewBorderBrush" ResourceKey="ControlStrokeColorDefault" />
      <StaticResource x:Key="CalendarViewWeekDayForegroundDisabled" ResourceKey="TextFillColorDisabled" />
      <StaticResource x:Key="CalendarViewNavigationButtonBackground" ResourceKey="SubtleFillColorTransparent" />
      <StaticResource x:Key="CalendarViewNavigationButtonForegroundPointerOver" ResourceKey="TextFillColorPrimary" />
      <StaticResource x:Key="CalendarViewNavigationButtonForegroundPressed" ResourceKey="ControlAltFillColorTertiary" />
      <StaticResource x:Key="CalendarViewCalendarItemRevealBackground" ResourceKey="SystemControlTransparentRevealBackgroundBrush" />
      <StaticResource x:Key="CalendarViewCalendarItemRevealBorderBrush" ResourceKey="SystemControlTransparentRevealBorderBrush" />
      <StaticResource x:Key="CalendarViewNavigationButtonBorderBrushPointerOver" ResourceKey="ControlStrokeColorDefault" />
      <StaticResource x:Key="CalendarViewNavigationButtonBorderBrush" ResourceKey="SubtleFillColorTransparent" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <StaticResource x:Key="CalendarViewSelectedHoverBorderBrush" ResourceKey="AccentFillColorSecondary" />
      <StaticResource x:Key="CalendarViewSelectedPressedBorderBrush" ResourceKey="SubtleFillColorTertiary" />
      <StaticResource x:Key="CalendarViewSelectedBorderBrush" ResourceKey="AccentFillColorDefault" />
      <StaticResource x:Key="CalendarViewHoverBorderBrush" ResourceKey="ControlStrokeColorDefault" />
      <StaticResource x:Key="CalendarViewPressedBorderBrush" ResourceKey="ControlStrokeColorDefault" />
      <StaticResource x:Key="CalendarViewTodayForeground" ResourceKey="TextOnAccentFillColorPrimary" />
      <StaticResource x:Key="CalendarViewBlackoutForeground" ResourceKey="TextFillColorDisabled" />
      <StaticResource x:Key="CalendarViewOutOfScopeForeground" ResourceKey="TextFillColorTertiary" />
      <StaticResource x:Key="CalendarViewCalendarItemForeground" ResourceKey="TextFillColorPrimary" />
      <StaticResource x:Key="CalendarViewOutOfScopeBackground" ResourceKey="SubtleFillColorTransparent" />
      <StaticResource x:Key="CalendarViewForeground" ResourceKey="TextFillColorPrimary" />
      <StaticResource x:Key="CalendarViewBackground" ResourceKey="ControlFillColorInputActive" />
      <StaticResource x:Key="CalendarViewBorderBrush" ResourceKey="ControlStrokeColorDefault" />
      <StaticResource x:Key="CalendarViewWeekDayForegroundDisabled" ResourceKey="TextFillColorDisabled" />
      <StaticResource x:Key="CalendarViewNavigationButtonBackground" ResourceKey="SubtleFillColorTransparent" />
      <StaticResource x:Key="CalendarViewNavigationButtonForegroundPointerOver" ResourceKey="TextFillColorPrimary" />
      <StaticResource x:Key="CalendarViewNavigationButtonForegroundPressed" ResourceKey="ControlAltFillColorTertiary" />
      <StaticResource x:Key="CalendarViewCalendarItemRevealBackground" ResourceKey="SystemControlTransparentRevealBackgroundBrush" />
      <StaticResource x:Key="CalendarViewCalendarItemRevealBorderBrush" ResourceKey="SystemControlTransparentRevealBorderBrush" />
      <StaticResource x:Key="CalendarViewNavigationButtonBorderBrushPointerOver" ResourceKey="ControlStrokeColorDefault" />
      <StaticResource x:Key="CalendarViewNavigationButtonBorderBrush" ResourceKey="SubtleFillColorTransparent" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <x:Double x:Key="CalendarFontSize">20</x:Double>
  <x:Double x:Key="CalendarDayButtonFontSize">12</x:Double>
  <FontWeight x:Key="CalendarViewTodayFontWeight">SemiBold</FontWeight>


  <ControlTheme x:Key="{x:Type Calendar}" TargetType="Calendar" BasedOn="{StaticResource DefaultCalendarTheme}"/>

  <ControlTheme x:Key="DefaultCalendarTheme" TargetType="Calendar">
    <Setter Property="Foreground" Value="{DynamicResource CalendarViewForeground}" />
    <Setter Property="Background" Value="{DynamicResource CalendarViewBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CalendarViewBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{DynamicResource CalendarFontSize}" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel
          Name="PART_Root"
          HorizontalAlignment="Center"
          ClipToBounds="True">
          <CalendarItem
            Name="PART_CalendarItem"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}"
            HeaderBackground="{TemplateBinding HeaderBackground}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
