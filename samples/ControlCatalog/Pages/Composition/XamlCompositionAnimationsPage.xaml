                  <Setter Property="Composition.Scale">1,1.5,0</Setter>
                </KeyFrame>
                <KeyFrame Cue="40%">
                  <Setter Property="Composition.Offset" Value="{Binding AnimationCue3Value}"/>
                  <Setter Property="Composition.Scale">1.5,1,0</Setter>
                </KeyFrame>
                <KeyFrame Cue="60%">
                  <Setter Property="Composition.Offset" Value="{Binding AnimationCue4Value}"/>
                  <Setter Property="Composition.Scale">0.5,0.5,0</Setter>
                </KeyFrame>
                <KeyFrame Cue="100%">
                  <Setter Property="Composition.Offset" Value="{Binding AnimationCue1Value}"/>
                  <Setter Property="Composition.Scale">1,1,0</Setter>
