<![CDATA[<Border HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              BorderBrush="Gray"
              BorderThickness="2">
        <Border.Styles>
          <Style Selector="Ellipse.KeyFrameAnimationElipse">
