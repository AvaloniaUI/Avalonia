<ContentPage Theme="{StaticResource ScrollPage}"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             Header="Composition"
             x:Class="ControlCatalog.Pages.Composition.CompositionHomePage">
  <Grid>
    <NavigationPage x:Name="SampleNav">
      <NavigationPage.Styles>
        <Style Selector="NavigationPage#SampleNav /template/ Border#PART_NavigationBar">
          <Setter Property="Background" Value="Transparent" />
        </Style>
      </NavigationPage.Styles>
    </NavigationPage>
  </Grid>
</ContentPage>
