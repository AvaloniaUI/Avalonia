<ContentPage Theme="{StaticResource ScrollPage}" x:Class="ControlCatalog.Pages.BackdropEffectPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="800"
             Header="BackdropEffect"
             d:DesignWidth="400"
             mc:Ignorable="d">
  <StackPanel Spacing="20">
    <TextBlock TextWrapping="Wrap"
               Text="Visual.BackdropEffect applies an effect to the content rendered behind a control's subtree. Here a BlurEffect produces a frosted-glass panel that samples and blurs the live content underneath it." />

    <Border CornerRadius="8" ClipToBounds="True" Height="320" MaxWidth="660">
      <Panel>
        <!-- Busy backdrop content so the blur is clearly visible. -->
        <Panel>
          <Panel.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
              <GradientStop Color="#FF3A7BD5" Offset="0" />
              <GradientStop Color="#FF00D2FF" Offset="1" />
            </LinearGradientBrush>
          </Panel.Background>
          <Ellipse Width="160" Height="160" Fill="#FFFF5F6D"
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24" />
          <Ellipse Width="200" Height="200" Fill="#FFFFC371"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24" />
          <TextBlock Text="Live content" FontSize="42" FontWeight="Bold" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Panel>
        <ProgressBar HorizontalAlignment="Stretch" VerticalAlignment="Center" x:Name="Progress" IsIndeterminate="True"/>

        <!-- Frosted overlay: BackdropEffect blurs everything drawn behind this Border. -->
        <Border Width="360" Height="150"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                CornerRadius="16" Background="#30FFFFFF"
                BorderBrush="#50FFFFFF" BorderThickness="1"
                x:Name="Frosted">
          <Border.BackdropEffect>
            <BlurEffect Radius="18" />
          </Border.BackdropEffect>
          <TextBlock Text="Backdrop blur" FontSize="20" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </Panel>
    </Border>
    <CheckBox IsChecked="{Binding #Progress.IsVisible}">Animate background</CheckBox>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock VerticalAlignment="Center" Text="Cache mode:" />
      <ComboBox SelectedIndex="0" SelectionChanged="CacheMode_SelectionChanged">
        <ComboBoxItem>Default</ComboBoxItem>
        <ComboBoxItem>Retained</ComboBoxItem>
        <ComboBoxItem>Volatile</ComboBoxItem>
      </ComboBox>
    </StackPanel>

    <!-- Bug repro: the same frosted panel, but inside a ScrollViewer that has an OpacityMask. The mask makes
         the renderer open an intermediate layer around the panel's backdrop, which used to stop the blur from
         rendering at all. -->
    <TextBlock TextWrapping="Wrap"
               Text="Bug repro: a BackdropEffect blur inside a ScrollViewer with an OpacityMask. The mask fades the ScrollViewer's content out at the edges, and while it is applied an intermediate layer stays open around the blurred panel. The blur used to disappear in that case; it should always stay visible. Scroll and toggle the mask to compare." />

    <StackPanel Orientation="Horizontal" Spacing="8">
      <CheckBox x:Name="MaskToggle" IsChecked="True" IsCheckedChanged="MaskToggle_IsCheckedChanged">
        OpacityMask on the ScrollViewer
      </CheckBox>
      <TextBlock VerticalAlignment="Center" Text="Cache mode:" />
      <ComboBox SelectedIndex="0" SelectionChanged="MaskedCacheMode_SelectionChanged">
        <ComboBoxItem>Default</ComboBoxItem>
        <ComboBoxItem>Retained</ComboBoxItem>
        <ComboBoxItem>Volatile</ComboBoxItem>
      </ComboBox>
    </StackPanel>

    <Border CornerRadius="8" ClipToBounds="True" Height="320" MaxWidth="660">
      <ScrollViewer x:Name="MaskedScroll" HorizontalScrollBarVisibility="Disabled">
        <ScrollViewer.OpacityMask>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#00000000" Offset="0" />
            <GradientStop Color="#FF000000" Offset="0.15" />
            <GradientStop Color="#FF000000" Offset="0.85" />
            <GradientStop Color="#00000000" Offset="1" />
          </LinearGradientBrush>
        </ScrollViewer.OpacityMask>
        <Panel Height="700">
          <!-- Busy scrolled content so the blur is clearly visible. -->
          <StackPanel Margin="20,16" Spacing="12">
            <Border Height="90" CornerRadius="8" Background="#FFEF4444" />
            <Border Height="90" CornerRadius="8" Background="#FFF59E0B" />
            <Border Height="90" CornerRadius="8" Background="#FF10B981" />
            <Border Height="90" CornerRadius="8" Background="#FF3B82F6" />
            <Border Height="90" CornerRadius="8" Background="#FF8B5CF6" />
            <Border Height="90" CornerRadius="8" Background="#FFEC4899" />
          </StackPanel>
          <!-- Frosted overlay: its BackdropEffect must keep blurring while the mask is applied. -->
          <Border Width="340" Height="150"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  CornerRadius="16" Background="#30FFFFFF"
                  BorderBrush="#50FFFFFF" BorderThickness="1"
                  x:Name="MaskedFrosted">
            <Border.BackdropEffect>
              <BlurEffect Radius="18" />
            </Border.BackdropEffect>
            <TextBlock Text="Backdrop blur (masked)" FontSize="18" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </Panel>
      </ScrollViewer>
    </Border>
  </StackPanel>
</ContentPage>
