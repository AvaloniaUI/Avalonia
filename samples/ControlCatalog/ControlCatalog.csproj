<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(AvsCurrentTargetFramework)</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IncludeAvaloniaGenerators>true</IncludeAvaloniaGenerators>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="**\*.xaml.cs">
      <DependentUpon>%(Filename)</DependentUpon>
    </Compile>
    <AvaloniaXaml Include="**\*.xaml">
      <SubType>Designer</SubType>
    </AvaloniaXaml>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="$(SharedAssetsPath)\icon.ico" Link="Assets\icon.ico" />
    <AvaloniaResource Include="$(SharedAssetsPath)\icon-32.png" Link="Assets\icon-32.png" />
    <AvaloniaResource Include="Assets\**\*" />
    <EmbeddedResource Include="Assets\Fonts\*.*" />
    <EmbeddedResource Include="Pages\teapot.bin" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\packages\Avalonia\Avalonia.csproj" />
    <ProjectReference Include="..\..\src\Avalonia.Controls.ColorPicker\Avalonia.Controls.ColorPicker.csproj" />
    <ProjectReference Include="..\..\src\Avalonia.Themes.Simple\Avalonia.Themes.Simple.csproj" />
    <ProjectReference Include="..\..\src\Avalonia.Themes.Fluent\Avalonia.Themes.Fluent.csproj" />
    <ProjectReference Include="..\..\src\Avalonia.Fonts.Inter\Avalonia.Fonts.Inter.csproj" />
    <ProjectReference Include="..\..\src\Skia\Avalonia.Skia\Avalonia.Skia.csproj" />
    <ProjectReference Include="..\MiniMvvm\MiniMvvm.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaXaml Update="Pages\Composition\BrushAnimationsPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </AvaloniaXaml>
    <AvaloniaXaml Update="Pages\Composition\CompositionHomePage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </AvaloniaXaml>
    <AvaloniaXaml Update="Pages\Composition\CustomAnimationPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </AvaloniaXaml>
    <AvaloniaXaml Update="Pages\Composition\ExplicitAnimationsPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </AvaloniaXaml>
    <AvaloniaXaml Update="Pages\Composition\ImplicitAnimationsPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </AvaloniaXaml>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Pages\Composition\BrushAnimationsPage.xaml.cs">
      <DependentUpon>BrushAnimationsPage.xaml</DependentUpon>
    </Compile>
    <Compile Update="Pages\Composition\CompositionHomePage.xaml.cs">
      <DependentUpon>CompositionHomePage.xaml</DependentUpon>
    </Compile>
    <Compile Update="Pages\Composition\CustomAnimationPage.xaml.cs">
      <DependentUpon>CustomAnimationPage.xaml</DependentUpon>
    </Compile>
    <Compile Update="Pages\Composition\ExplicitAnimationsPage.xaml.cs">
      <DependentUpon>ExplicitAnimationsPage.xaml</DependentUpon>
    </Compile>
    <Compile Update="Pages\Composition\ImplicitAnimationsPage.xaml.cs">
      <DependentUpon>ImplicitAnimationsPage.xaml</DependentUpon>
    </Compile>
  </ItemGroup>

  <Import Project="..\..\build\BuildTargets.targets" />
  <Import Project="..\..\build\SourceGenerators.props" />
  <Import Project="..\..\build\SkiaSharp.props" />
</Project>
