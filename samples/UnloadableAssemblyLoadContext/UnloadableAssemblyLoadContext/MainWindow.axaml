<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="UnloadableAssemblyLoadContext.MainWindow"
        Title="UnloadableAssemblyLoadContext" Width="620" Height="220">
    <StackPanel Margin="24" Spacing="16">
        <TextBlock x:Name="Status" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="LoadButton" Content="Load plugin" Click="OnLoadClick" />
            <Button x:Name="UnloadButton" Content="Unload plugin" Click="OnUnloadClick" IsEnabled="False" />
        </StackPanel>
    </StackPanel>
</Window>
